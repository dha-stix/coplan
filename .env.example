# Your site's public address, used for share-preview links (no trailing slash).
# e.g. https://coplan.app — on Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Firebase — Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# EmailJS — used to email workspace/project invites
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_INVITE_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
